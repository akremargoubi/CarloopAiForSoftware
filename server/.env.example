# Copier ce fichier en .env (jamais commité) puis remplacer les valeurs <...>.

# --- Serveur ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# true uniquement derrière un reverse proxy (Render, Railway, nginx...)
TRUST_PROXY=false

# --- PostgreSQL (utilisé par docker-compose.yml ET par Prisma) ---
POSTGRES_USER=carloop
POSTGRES_PASSWORD=<choisir-un-mot-de-passe-local>
POSTGRES_DB=carloop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://carloop:<choisir-un-mot-de-passe-local>@localhost:5432/carloop
# Base utilisée par `npm test` (créée automatiquement, vidée à chaque lancement)
TEST_DATABASE_URL=postgresql://carloop:<choisir-un-mot-de-passe-local>@localhost:5432/carloop_test

# --- Auth ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<au-moins-32-caracteres-aleatoires>
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# --- Recherche sémantique (modèle local) ---
# Modèle retenu après évaluation (voir docs/MODEL.md). Préfixes E5 gérés automatiquement.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DTYPE=q8
EMBEDDING_TIMEOUT_MS=3000
EMBEDDING_ENABLED=true
MODEL_CACHE_DIR=.model-cache
# Seuil calibré par npm run eval pour e5-small (à recalibrer si le modèle change)
SEARCH_MIN_SCORE=0.83

# --- Seed (comptes de démo) ---
SEED_USER_PASSWORD=<mot-de-passe-des-comptes-de-demo>

# --- Diagnostic IA (Akrem) - optionnel pour l'instant ---
OPENROUTER_API_KEY=
# Modèles ":free" séparés par des virgules : le premier est principal, les suivants en secours
OPENROUTER_MODELS=
