# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/carloop

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI (OpenRouter, OpenAI-compatible API) ---
# Leave empty and set AI_MOCK=true to run the demo mode (simulated answers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MOCK=true
AI_TIMEOUT_MS=15000
# Max calls per user/IP per minute on /api/ai/*
AI_RATE_LIMIT_PER_MIN=20
