# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed front-end origins
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/carloop

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI (OpenRouter, OpenAI-compatible API) ---
# Leave empty and set AI_MOCK=true to run the demo mode (simulated answers)
OPENROUTER_API_KEY=
# One model, or several comma-separated: the next ones are fallbacks (see docs/EVALUATION.md)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MOCK=true
# Free reasoning models can take up to ~75 s (paid models such as openai/gpt-4o-mini: a few seconds)
AI_TIMEOUT_MS=90000
# Max calls per user/IP per minute on /api/ai/*
AI_RATE_LIMIT_PER_MIN=20
