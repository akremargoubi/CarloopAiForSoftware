{
  "name": "carloop-server",
  "version": "1.0.0",
  "private": true,
  "description": "API REST CarLoop Web (Express + Prisma) avec recherche sémantique locale",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --ignoreConfig --noEmit --allowJs --checkJs --strict --lib ES2024,DOM --target ES2024 --types node public/demo/demo.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed": "tsx src/scripts/seed.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.ts"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.ts",
    "testTimeout": 20000,
    "clearMocks": true
  }
}
