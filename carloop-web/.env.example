# Used by docker-compose.yml (Dokploy Environment tab). Not needed for `npm run dev`:
# in dev, copy server/.env.example to server/.env instead.
POSTGRES_PASSWORD=change-me
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Public URL of the deployed app, e.g. https://carloop.example.com
APP_URL=http://localhost
