PORT=4000
# Local Postgres (installed on your machine) or a hosted one (Neon, Supabase, Dokploy...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/carloop
# Set to true for hosted Postgres that requires SSL (Neon, Supabase)
DATABASE_SSL=false
# Comma separated list. Not needed in dev: Vite proxies /api to this server.
CORS_ORIGIN=http://localhost:5173

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000
# Sent to OpenRouter as HTTP-Referer (app attribution)
APP_URL=http://localhost:5173
